# macOS folder metadata
.DS_Store

# Font kaynak dosyaları (woff2'ye subset edilir; kaynaklar repoda tutulmaz — ~152MB)
assets/fonts/*.ttf
assets/fonts/*.otf

# Üretilen site. Tek gerçek kaynak data/ + src/ — dist/ commit'lenirse
# iki gerçek kaynak olur ve hangisinin doğru olduğu bilinmez.
dist/

# İç planlama dokümanları. Repo public olduğu için yayınlanmıyorlar
# (maliyet kalemleri, tedarikçi değerlendirmesi, bayi/kiosk sayıları).
docs/

# Wrangler'ın yerel önbelleği ve gizli değişken dosyası. Yapılandırma
# wrangler.jsonc'de ve repoda; bunlar makineye özel.
.wrangler/
.dev.vars

# Claude Code'un makineye özel izin listesi ve geçici worktree'leri.
# .claude/launch.json paylaşılır (önizleme sunucusu tanımı), bunlar paylaşılmaz.
.claude/settings.local.json
.claude/worktrees/
